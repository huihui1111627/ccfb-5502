{
  "name": "ics-traffic-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器端工控(Modbus/TCP)流量分析台：流式解析、TCP重组、基线学习与攻击检测",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "stress": "node --max-old-space-size=512 --import tsx tests/stress/large-file.mts",
    "gen:testdata": "tsx tests/gen/cli.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
